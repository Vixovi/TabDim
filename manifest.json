{
  "manifest_version": 3,
  "name": "TabDim",
  "version": "1.1.1",
  "description": "Oscurece cada pestaña de forma independiente, sin cambiar los estilos de la web.",
  "minimum_chrome_version": "123",
  "permissions": ["storage", "scripting", "contextMenus", "tabs"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "TabDim", "default_popup": "control.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["shade.js"], "run_at": "document_start", "all_frames": false}]
}
